# Runtime knobs (NON-SECRET). Copy/edit the systemd Environment= or pass as
# flags. This file contains no credentials and must never gain any: the graph
# has no provider/model/credential path by design.

# Loopback bind (adapter refuses non-loopback)
LG_HOST=127.0.0.1
LG_PORT=8791

# Existing read-only retrieval contract (unchanged by this module)
LG_KNOWLEDGE_SEARCH_URL=http://127.0.0.1:8788/knowledge_search

# Published freshness-contract read path (task t_de551615). Reconcile the exact
# endpoint/field names with that published contract at admission.
LG_FRESHNESS_URL=http://127.0.0.1:8790/freshness

# Freshness SLA and expected index version
LG_SLA_SECONDS=900
LG_INDEX_VERSION=rag-v1

# Bounded retrieval limits
LG_RETRIEVAL_TIMEOUT=5.0
LG_FRESHNESS_TIMEOUT=3.0
LG_MAX_RETRIES=2
LG_MAX_EVIDENCE=10

# Server-side wall-clock budget for one request (0 disables it). Must stay
# inside the rag-auto plugin's 6.0 s hook deadline.
LG_REQUEST_DEADLINE=5.0

# Redacted JSONL provenance: one line per /rag_answer, no query text or
# snippets. Empty string disables the sink.
LG_METRICS_PATH=/var/lib/hermes-langgraph/rag-metrics.jsonl

# Persistence: file-backed SQLite OUTSIDE the Nix store (durable, not on tmpfs).
# The production service refuses to start with the in-memory saver.
LG_CHECKPOINT=sqlite
LG_CHECKPOINT_PATH=/var/lib/hermes-langgraph/checkpoints.sqlite3
